<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".demo.componentDemo.ButtonDemoActivity">

    <Button
        android:id="@+id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="Click"
        android:text="登录" />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="登录2"/>

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="登录3"/>

    <Button
        android:id="@+id/button4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="登录4"/>

    <Button
        android:id="@+id/buttonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="圆角按钮"
        app:backgroundTint="@android:color/holo_red_light"
        app:strokeColor="@android:color/holo_green_light"
        app:strokeWidth="2dp"
        app:cornerRadius="10dp"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@android:drawable/ic_dialog_info"
        android:text="图标按钮" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="禁用按钮"
        android:enabled="false"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选择按钮"
        android:background="@drawable/custom_button_selector"/>

    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Material图标"
        app:backgroundTint="@android:color/holo_red_light"
        app:strokeColor="@android:color/holo_green_light"
        app:strokeWidth="2dp"
        app:cornerRadius="10dp"
        app:icon="@drawable/wechat"/>


</LinearLayout>