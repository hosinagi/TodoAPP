<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".demo.componentDemo.DialogDemoActivity">

    <Button
        android:onClick="onAlertDialogClick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="警示性窗口"/>

    <Button
        android:onClick="onAlertDialogClick2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="单选窗口"/>

    <Button
        android:onClick="onAlertDialogClick3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="多选窗口"/>

    <Button
        android:onClick="onAlertDialogClick4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="简单自定义窗口"/>

    <Button
        android:onClick="onAlertDialogClick5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="完全自定义窗口"/>

</LinearLayout>